<resources>
    <!-- Base application theme. -->
    <style name="Theme.Megz" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_wechat</item>
        <item name="colorPrimaryVariant">@color/accent_wechat_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_wechat</item>
        <item name="colorSecondaryVariant">@color/accent_wechat_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Edge-to-edge: transparent status bar, content draws behind -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="Theme.Megz.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
